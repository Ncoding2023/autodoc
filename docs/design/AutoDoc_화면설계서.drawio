      </mxCell>
      <mxCell id="14-1" parent="1" vertex="1" value="진입: 입력 형식 확인 → 문서 데이터 저장 → DOCX 생성" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#64748B;fontSize=16;fontFamily=Malgun Gothic;fontStyle=0;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="35" y="70" width="1530" height="32" />
