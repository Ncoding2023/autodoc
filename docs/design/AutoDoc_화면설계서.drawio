<diagram name="12 DOCS개정·DOCS 템플릿 선택" id="docs-revision-12">
  <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" guides="1" connect="1" arrows="1">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      <mxCell id="12-0" parent="1" vertex="1" value="AutoDoc · DOCS 개정안 12 | DOCS 템플릿 선택" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#172B4D;fontSize=26;fontFamily=Malgun Gothic;fontStyle=1;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="35" y="22" width="1530" height="42" />
      </mxCell>
      <mxCell id="12-1" parent="1" vertex="1" value="진입: 새 문서 → DOCS 선택 → 기본 / 내 템플릿 선택" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#64748B;fontSize=16;fontFamily=Malgun Gothic;fontStyle=0;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="35" y="70" width="1530" height="32" />
      </mxCell>
      <mxCell id="12-2" parent="1" vertex="1" value="AutoDoc    /    대시보드    /    문서 관리    /    템플릿 관리                                             내 계정    로그아웃" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#172B4D;strokeColor=#172B4D;fontColor=white;fontSize=17;fontFamily=Malgun Gothic;fontStyle=1;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="35" y="118" width="1530" height="54" />
      </mxCell>
      <mxCell id="12-3" parent="1" vertex="1" value="템플릿 등록 완료 후 목록으로 돌아오며, 등록된 템플릿을 선택해 바로 작성할 수 있다. 기본 양식은 업로드 없이 시작한다.&lt;br&gt;작성 시작은 등록이 완료된 템플릿을 선택했을 때만 활성화한다. 로딩·빈 목록·조회 실패 시 안내와 재시도를 제공한다.&lt;br&gt;11·13 화면의 항목명을 바로 입력해 바꾼다. 별도 수정 창은 없다. 입력값과 위치는 유지한다. 항목 추가·삭제·배치 변경은 제공하지 않는다." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#172B4D;fontSize=16;fontFamily=Malgun Gothic;fontStyle=0;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="35" y="842" width="1530" height="130" />
      </mxCell>
      <mxCell id="12-4" parent="1" vertex="1" value="어떤 양식으로 작성하시겠습니까?" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#172B4D;fontSize=23;fontFamily=Malgun Gothic;fontStyle=1;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="60" y="194" width="1460" height="38" />
      </mxCell>
      <mxCell id="12-5" parent="1" vertex="1" value="회사 양식을 등록하거나, 준비된 기본 양식을 선택해 바로 시작하세요." style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#64748B;fontSize=15;fontFamily=Malgun Gothic;fontStyle=0;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="60" y="236" width="1460" height="30" />
      </mxCell>
      <mxCell id="12-6" parent="1" vertex="1" value="기본 템플릿" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#2563EB;strokeColor=#2563EB;fontColor=white;fontSize=17;fontFamily=Malgun Gothic;fontStyle=1;align=center;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="60" y="284" width="180" height="42" />
      </mxCell>
      <mxCell id="12-7" parent="1" vertex="1" value="내 템플릿" style="rounded=0;html=1;whiteSpace=wrap;fillColor=white;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=17;fontFamily=Malgun Gothic;fontStyle=1;align=center;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="255" y="284" width="180" height="42" />
      </mxCell>
      <mxCell id="12-8" parent="1" vertex="1" value="DOCX 양식 등록 → 10" style="rounded=0;html=1;whiteSpace=wrap;fillColor=white;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=17;fontFamily=Malgun Gothic;fontStyle=1;align=center;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="1250" y="284" width="270" height="42" />
      </mxCell>
