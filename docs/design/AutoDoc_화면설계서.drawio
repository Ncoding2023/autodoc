      <mxCell id="09-0" parent="1" vertex="1" value="AutoDoc · DOCS 개정안 09 | DOCS 사용자 흐름" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#172B4D;fontSize=26;fontFamily=Malgun Gothic;fontStyle=1;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="35" y="22" width="1530" height="42" />
      </mxCell>
      <mxCell id="09-1" parent="1" vertex="1" value="설계 초안 · 2026-10-23 · 양식 등록은 한 번, 문서 작성은 반복 사용" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#64748B;fontSize=16;fontFamily=Malgun Gothic;fontStyle=0;align=left;verticalAlign=middle;spacing=14;">
        <mxGeometry as="geometry" x="35" y="70" width="1530" height="32" />
